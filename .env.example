# Shared store for releases + color stats (Upstash / Vercel KV).
# Without these the app falls back to an in-memory store (per-instance,
# NOT shared across serverless instances) — fine for local dev, NOT for production.
#
# Vercel: Storage → add "Upstash for Redis" to the project; these are injected automatically.
# Local:  `vercel link` then `vercel env pull .env.local`.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternatively (plain Upstash, outside Vercel KV):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
